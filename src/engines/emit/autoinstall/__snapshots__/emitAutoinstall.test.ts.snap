// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitAutoinstall > golden output: 'encrypted-ubuntu' 1`] = `
"#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ""
  timezone: UTC
  identity:
    hostname: localhost.localdomain
    username: admin
    realname: admin
    password: "!"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys: []
  storage:
    layout:
      name: lvm
      password: secret
  packages:
    - openssh-server
  late-commands:
    - curtin in-target -- systemctl enable myservice
  shutdown: reboot
"
`;

exports[`emitAutoinstall > golden output: 'minimal-ubuntu' 1`] = `
"#cloud-config
autoinstall:
  version: 1
